local function updateGuiSizeAndWidth(murdName, sherName, heroName)
    local maxTextWidth = 0

    for _, name in ipairs({murdName, sherName, heroName}) do
        if name then
            maxTextWidth = math.max(
                maxTextWidth,
                textservice:GetTextSize(
                    name,
                    14,
                    Enum.Font.FredokaOne,
                    Vector2.new(1000, 22)
                ).X
            )
        end
    end

    local calculatedWidth = math.max(MIN_WIDTH, maxTextWidth + 85)
    local targetHeight = BASE_HEIGHT

    if murdName then targetHeight += 78 end
    if sherName then targetHeight += 78 end
    if heroName then targetHeight += 78 end

    if calculatedWidth == lastGuiWidth and targetHeight == lastGuiHeight then
        return
    end

    lastGuiWidth = calculatedWidth
    lastGuiHeight = targetHeight

    if resizeTween then
        resizeTween:Cancel()
    end

    resizeTween = tweenservice:Create(
        mainframe,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = UDim2.fromOffset(calculatedWidth, targetHeight)}
    )

    resizeTween:Play()
end

-- ======================== ROLE DETECTION ========================
local function scanContainerForRole(container)
    if not container then
        return nil, COLORS.Default
    end

    for _, item in ipairs(container:GetChildren()) do
        if item:IsA("Tool") then
            local name = string.lower(item.Name)

            if name:find("knife", 1, true)
                or name:find("blade", 1, true) then
                return "Murderer", COLORS.Knife
            end

            if name:find("gun", 1, true)
                or name:find("revolver", 1, true) then
                if sheriffDiedThisRound then
                    return "Hero", COLORS.Hero
                end

                return "Sheriff", COLORS.Gun
            end
        end
    end

    return nil, COLORS.Default
end

local function getPlayerRoleAndColor(plr)
    if not plr then
        return nil, COLORS.Default
    end

    local char = plr.Character

    if char then
        local role, color = scanContainerForRole(char)

        if role then
            return role, color
        end
    end

    local backpack = plr:FindFirstChildOfClass("Backpack")

    if backpack then
        local role, color = scanContainerForRole(backpack)

        if role then
            return role, color
        end
    end

    return nil, COLORS.Default
end

-- ======================== GUN DROP POSITION HELPERS ========================
local function getWorldPosition(obj)
    if not obj or not obj.Parent then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Model") then
        local success, pivot = pcall(function()
            return obj:GetPivot()
        end)

        if success then
            return pivot.Position
        end
    end

    return nil
end

local function findNearbyDeath(gunPosition)
    if not gunPosition then
        return nil
    end

    local closestUserId = nil
    local closestDistance = GUN_DEATH_RADIUS

    for userId, deathPosition in pairs(recordedGunDeathPositions) do
        local distance = (gunPosition - deathPosition).Magnitude

        if distance <= closestDistance then
            closestDistance = distance
            closestUserId = userId
        end
    end

    return closestUserId
end

-- ======================== PLAYER / GUN CHAMS ========================
local function createChams(plr)
    if not scriptrunning or not plr or plr == localplayer then
        return
    end

    local char = plr.Character

    if not char or not char.Parent then
        return
    end

    local _, roleColor = getPlayerRoleAndColor(plr)
    local highlightColor = roleColor or COLORS.Default
    local highlight = chams[plr]

    if not highlight or not highlight.Parent then
        highlight = Instance.new("Highlight")
        highlight.Name = "MM2EspHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0.2
        chams[plr] = highlight
    end

    highlight.Adornee = char
    highlight.FillColor = highlightColor
    highlight.OutlineColor = getOutlineColor(highlightColor)
    highlight.Enabled = chamEnabled
    highlight.Parent = hiddenUI
end

local function removeChams(plr)
    local highlight = chams[plr]

    if highlight then
        pcall(function()
            highlight:Destroy()
        end)

        chams[plr] = nil
    end
end

local function createGunCham(obj)
    if not scriptrunning or not obj or droppedGunChams[obj] then
        return
    end

    if obj.Name ~= "GunDrop"
        and not (obj:IsA("BasePart") and obj.Name == "Gun") then
        return
    end

    local gunPosition = getWorldPosition(obj)

    if not gunPosition then
        return
    end

    -- No sheriff/hero death position means no gun-drop highlight.
    local matchedUserId = findNearbyDeath(gunPosition)

    if not matchedUserId then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MM2GunHighlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = COLORS.Gun
    highlight.OutlineColor = getOutlineColor(COLORS.Gun)
    highlight.FillTransparency = 0.8
    highlight.OutlineTransparency = 0.2
    highlight.Enabled = chamEnabled
    highlight.Adornee = obj
    highlight.Parent = hiddenUI

    droppedGunChams[obj] = {
        Highlight = highlight,
        DeathUserId = matchedUserId,
    }
end

local function refreshGunChamsNearDeath(userId)
    local deathPosition = recordedGunDeathPositions[userId]

    if not deathPosition then
        return
    end

    -- Check existing highlights against the newly recorded death position.
    for obj, data in pairs(droppedGunChams) do
        local position = getWorldPosition(obj)

        if not position
            or (position - deathPosition).Magnitude > GUN_DEATH_RADIUS then
            destroyGunCham(obj)
        end
    end

    -- Find drops that appeared before the death event.
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop"
            or (obj:IsA("BasePart") and obj.Name == "Gun") then
            createGunCham(obj)
        end
    end
end

