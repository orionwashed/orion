-- ======================== COIN DETECTION ========================
local function iscoin(obj)
    if not obj or not obj:IsA("BasePart") then
        return false
    end

    if not obj.Parent or obj.Transparency >= 1 then
        return false
    end

    local name = string.lower(obj.Name)

    return name:find("coin", 1, true) ~= nil
        or name:find("candy", 1, true) ~= nil
        or name:find("token", 1, true) ~= nil
end

local function addCoin(obj)
    if not iscoin(obj) or activecoinset[obj] then
        return
    end

    if not currentmap or not obj:IsDescendantOf(currentmap) then
        return
    end

    activecoinset[obj] = true
    table.insert(activecoins, obj)
end

local function removeCoin(obj)
    if obj then
        activecoinset[obj] = nil
    end
end

local function refreshcoins()
    table.clear(activecoins)
    table.clear(activecoinset)

    nextCoinRefresh = os.clock() + COIN_REFRESH_INTERVAL

    if not currentmap or not currentmap.Parent then
        return
    end

    for _, obj in ipairs(currentmap:GetDescendants()) do
        addCoin(obj)
    end
end

local function removeTargetHighlight()
    if targethighlight then
        targethighlight:Destroy()
        targethighlight = nil
    end
end

local function stopmovement()
    if activetween then
        pcall(function()
            activetween:Cancel()
        end)

        activetween = nil
    end

    istweening = false
    currenttargetcoin = nil
    removeTargetHighlight()
end

-- ======================== NOCLIP ========================
local function setnoclip(state)
    if state then
        if noclipconnection then
            return
        end

        noclipconnection = runservice.Stepped:Connect(function()
            if not scriptrunning or not autofarmcoins then
                return
            end

            local char = localplayer.Character

            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    elseif noclipconnection then
        noclipconnection:Disconnect()
        noclipconnection = nil
    end
end

