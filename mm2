local function checkworkspaceformap()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") and child.Name ~= "Lobby" then
            if child:FindFirstChild("CoinContainer")
                or child:FindFirstChild("Spawns")
