                if role == "Murderer" then
                    table.insert(murdererPlayers, plr)
                elseif role == "Sheriff" then
                    table.insert(sheriffPlayers, plr)
                    currentSheriffUserId = plr.UserId
                elseif role == "Hero" then
                    table.insert(heroPlayers, plr)
                end
            end
        end

        local foundMurd =
            #murdererPlayers == 1 and murdererPlayers[1] or nil

        local foundSher =
            #sheriffPlayers == 1 and sheriffPlayers[1] or nil

        local foundHero =
            #heroPlayers == 1 and heroPlayers[1] or nil

        local myPos = hrp and hrp.Position or Vector3.zero

        local function getDistance(plr)
            local root = plr.Character
                and plr.Character:FindFirstChild("HumanoidRootPart")

            if root and hrp then
                return math.floor((root.Position - myPos).Magnitude)
            end

            return 0
        end

        local function updateRoleCard(plr, headerLabel, box, nameLabel,
            distLabel, icon, lastUserId, roleDistance)
            headerLabel.Visible = plr ~= nil
            box.Visible = plr ~= nil

            if not plr then
                nameLabel.Text = ""
                distLabel.Text = ""
                box:SetAttribute("TargetUserId", nil)

                if lastUserId.value ~= nil then
                    lastUserId.value = nil
                    updateAvatarImage(icon, nil)
                end

                return
            end

            nameLabel.Text = plr.Name
            distLabel.Text = roleDistance .. " studs"
            box:SetAttribute("TargetUserId", plr.UserId)

            if lastUserId.value ~= plr.UserId then
                lastUserId.value = plr.UserId
                updateAvatarImage(icon, plr.UserId)
            end
        end

        local murdId = {value = lastMurdUserId}
        local sherId = {value = lastSherUserId}
        local heroId = {value = lastHeroUserId}

        updateRoleCard(
            foundMurd, murdHeader, murdBox, murdNameLabel,
            murdDistLabel, murdIcon, murdId,
            foundMurd and getDistance(foundMurd) or 0
        )

        updateRoleCard(
            foundSher, sherHeader, sherBox, sherNameLabel,
            sherDistLabel, sherIcon, sherId,
            foundSher and getDistance(foundSher) or 0
        )

        updateRoleCard(
            foundHero, heroHeader, heroBox, heroNameLabel,
            heroDistLabel, heroIcon, heroId,
            foundHero and getDistance(foundHero) or 0
        )

        lastMurdUserId = murdId.value
        lastSherUserId = sherId.value
        lastHeroUserId = heroId.value

        updateGuiSizeAndWidth(
            foundMurd and foundMurd.Name,
            foundSher and foundSher.Name,
            foundHero and foundHero.Name
        )

        -- ======================== SAFE COIN TARGETING ========================
        if hrp and humanoid and humanoid.Health > 0
            and isgameactive
            and not waitingfornextround
            and autofarmcoins then

            local function isSafeCoinTarget(coin)
                if not coin
                    or not coin.Parent
                    or not coin:IsA("BasePart")
                    or coin.Transparency >= 1
                    or not currentmap
                    or not coin:IsDescendantOf(currentmap) then
                    return false
                end

                if not autoavoid then
                    return true
                end

                local myRole, _ = getPlayerRoleAndColor(localplayer)

                if myRole == "Murderer" then
                    for _, sheriff in ipairs(sheriffPlayers) do
                        local sheriffRoot = sheriff.Character
                            and sheriff.Character:FindFirstChild("HumanoidRootPart")

                        if sheriffRoot
                            and (sheriffRoot.Position - coin.Position).Magnitude < SAFE_RADIUS then
                            return false
                        end
                    end

                    for _, hero in ipairs(heroPlayers) do
                        local heroRoot = hero.Character
                            and hero.Character:FindFirstChild("HumanoidRootPart")

                        if heroRoot
                            and (heroRoot.Position - coin.Position).Magnitude < SAFE_RADIUS then
                            return false
                        end
                    end
                else
                    -- Innocent, Sheriff, or Hero (all avoid Murderer)
                    for _, murderer in ipairs(murdererPlayers) do
                        local murdererRoot = murderer.Character
                            and murderer.Character:FindFirstChild("HumanoidRootPart")

                        if murdererRoot
                            and (murdererRoot.Position - coin.Position).Magnitude < SAFE_RADIUS then
                            return false
                        end
                    end
                end

                return true
            end

            if currenttargetcoin and not isSafeCoinTarget(currenttargetcoin) then
                stopmovement()
            end

            if not istweening then
                local nearestcoin
                local shortestdist = math.huge

                for i = #activecoins, 1, -1 do
                    local coin = activecoins[i]

                    if not isSafeCoinTarget(coin) then
                        if coin then
                            activecoinset[coin] = nil
                        end

                        table.remove(activecoins, i)
                    else
                        local distance = (coin.Position - hrp.Position).Magnitude

                        if distance < shortestdist then
                            shortestdist = distance
                            nearestcoin = coin
                        end
                    end
                end

                if nearestcoin then
                    istweening = true
                    currenttargetcoin = nearestcoin

                    removeTargetHighlight()

                    targethighlight = Instance.new("Highlight")
                    targethighlight.Name = "CurrentCoinHighlight"
                    targethighlight.Adornee = nearestcoin
                    targethighlight.FillColor = COLORS.Default
                    targethighlight.FillTransparency = 0.8
                    targethighlight.OutlineColor = getOutlineColor(COLORS.Default)
                    targethighlight.OutlineTransparency = 0.2
                    targethighlight.Parent = hiddenUI

                    setstatus("collecting coins", Color3.fromRGB(100, 220, 120))

                    local distance = (nearestcoin.Position - hrp.Position).Magnitude
                    local travelTime = math.max(distance / COIN_TRAVEL_SPEED, 0.05)

                    local tween = tweenservice:Create(
                        hrp,
                        TweenInfo.new(
                            travelTime,
                            Enum.EasingStyle.Linear,
                            Enum.EasingDirection.InOut
                        ),
                        {CFrame = CFrame.new(nearestcoin.Position)}
                    )

                    activetween = tween

                    addConnection(tween.Completed:Connect(function(playbackState)
                        if activetween ~= tween then
                            return
                        end

                        if playbackState == Enum.PlaybackState.Completed then
                            removeCoin(nearestcoin)

                            for i = #activecoins, 1, -1 do
                                if activecoins[i] == nearestcoin then
                                    table.remove(activecoins, i)
                                    break
                                end
                            end
                        end

                        istweening = false
                        activetween = nil
                        currenttargetcoin = nil
                        removeTargetHighlight()
                    end))

                    tween:Play()
                else
                    setstatus("waiting for coins", Color3.fromRGB(235, 180, 50))

                    local now = os.clock()

                    if now >= nextCoinRefresh then
                        refreshcoins()
                        nextCoinRefresh = now + COIN_REFRESH_INTERVAL
                    end

                    if #activecoins == 0 then
                        task.wait(EMPTY_SEARCH_WAIT)
                    end
                end
            end
        end
    end
end)
