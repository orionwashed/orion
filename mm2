-- ======================== CONNECTION / HIGHLIGHT CLEANUP ========================
local function destroyGunCham(obj)
    local data = droppedGunChams[obj]

    if data then
        if data.Highlight then
            pcall(function()
                data.Highlight:Destroy()
            end)
        end

        droppedGunChams[obj] = nil
    end
end

local function clearGunChams()
    for obj in pairs(droppedGunChams) do
        destroyGunCham(obj)
    end

    table.clear(droppedGunChams)
end

