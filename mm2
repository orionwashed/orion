-- Repair highlights without recreating healthy instances.
task.spawn(function()
    while scriptrunning do
        task.wait(CHAM_REPAIR_INTERVAL)

        if not scriptrunning then
            break
        end

        for _, plr in ipairs(players:GetPlayers()) do
            if plr ~= localplayer then
                local character = plr.Character

                if character and character.Parent then
                    local highlight = chams[plr]

                    if not highlight or not highlight.Parent
                        or highlight.Adornee ~= character then
                        createChams(plr)
                    else
                        local _, color = getPlayerRoleAndColor(plr)
                        color = color or COLORS.Default

                        if highlight.FillColor ~= color then
                            highlight.FillColor = color
                        end

                        local outline = getOutlineColor(color)

                        if highlight.OutlineColor ~= outline then
                            highlight.OutlineColor = outline
                        end

                        if highlight.Enabled ~= chamEnabled then
                            highlight.Enabled = chamEnabled
                        end

                        if highlight.Parent ~= hiddenUI then
                            highlight.Parent = hiddenUI
                        end
                    end
                end
            end
        end

        -- Remove gun highlights if their drop moves outside the death radius.
        for obj, data in pairs(droppedGunChams) do
            local position = getWorldPosition(obj)
            local deathPosition = data.DeathUserId
                and recordedGunDeathPositions[data.DeathUserId]

            if not position or not deathPosition
                or (position - deathPosition).Magnitude > GUN_DEATH_RADIUS then
                destroyGunCham(obj)
            elseif not data.Highlight or not data.Highlight.Parent then
                destroyGunCham(obj)
                createGunCham(obj)
            elseif data.Highlight.Enabled ~= chamEnabled then
                data.Highlight.Enabled = chamEnabled
            end
        end
    end
end)

