local function setupRoleDeathTracking(plr)
    if plr == localplayer then
        return
    end

    local function attach(character)
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 5)

            if not humanoid or not scriptrunning then
                return
            end

            addConnection(humanoid.Died:Connect(function()
                if not scriptrunning or not isgameactive then
                    return
                end

                local role = previousRoles[plr]

                if role ~= "Sheriff"
                    and role ~= "Hero"
                    and currentSheriffUserId ~= plr.UserId then
                    return
                end

                -- Capture the death position immediately.
                local root = character:FindFirstChild("HumanoidRootPart")
                local deathPosition = root and root.Position

                if not deathPosition then
                    deathPosition = getWorldPosition(character)
                end

                if deathPosition then
                    recordedGunDeathPositions[plr.UserId] = deathPosition
                    refreshGunChamsNearDeath(plr.UserId)
                end

                if role == "Sheriff"
                    or currentSheriffUserId == plr.UserId then
                    sheriffDiedThisRound = true
                end
            end))
        end)
    end

    addConnection(plr.CharacterAdded:Connect(attach))

    if plr.Character then
        attach(plr.Character)
    end
end

