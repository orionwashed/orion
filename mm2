local updateroundstatus

updateroundstatus = function()
    if not scriptrunning or ischeckingmap then
        return
    end

    local detectedmap = checkworkspaceformap()

    if not detectedmap then
        roundgeneration += 1
        isgameactive = false
        waitingfornextround = false
        preptimeremaining = 0

        sheriffDiedThisRound = false
        currentSheriffUserId = nil
        table.clear(previousRoles)
        table.clear(recordedGunDeathPositions)
        clearGunChams()

        stopmovement()
        setnoclip(false)

        currentmap = nil
        table.clear(activecoins)
        table.clear(activecoinset)
        hascountedcurrentround = false

        if autofarmcoins then
            setstatus("intermission", Color3.fromRGB(235, 180, 50))
        else
            setstatus("disabled", Color3.new(1, 1, 1))
        end

        return
    end

    if detectedmap == currentmap then
        return
    end

    currentmap = detectedmap
    roundgeneration += 1

    local thisgeneration = roundgeneration

    isgameactive = false
    waitingfornextround = false
    sheriffDiedThisRound = false
    currentSheriffUserId = nil

    table.clear(previousRoles)
    table.clear(recordedGunDeathPositions)
    clearGunChams()

    stopmovement()
    setnoclip(false)

    table.clear(activecoins)
    table.clear(activecoinset)
    hascountedcurrentround = false

    if autofarmcoins then
        preptimeremaining = ROUND_START_DELAY

        setstatus(
            "preparing (" .. preptimeremaining .. "s)",
            Color3.fromRGB(235, 180, 50)
        )
    else
        preptimeremaining = 0
    end

    task.spawn(function()
        while scriptrunning
            and thisgeneration == roundgeneration
            and currentmap == detectedmap
            and preptimeremaining > 0 do

            task.wait(1)

            if not scriptrunning or thisgeneration ~= roundgeneration then
                return
            end

            if preptimeremaining > 0
                and currentstatustext:find("preparing", 1, true) then
                preptimeremaining -= 1

                roundstatus.Text =
                    "status: preparing (" .. preptimeremaining .. "s)"
            end
        end

        if not scriptrunning or thisgeneration ~= roundgeneration then
            return
        end

        if currentmap ~= detectedmap
            or checkworkspaceformap() ~= detectedmap then
            return
        end

        local character = localplayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if not humanoid or humanoid.Health <= 0 then
            return
        end

        isgameactive = true
        roundActiveStartTime = tick()

        if not hascountedcurrentround then
            roundsplayedcount += 1
            roundslabel.Text = "rounds played: " .. roundsplayedcount
            hascountedcurrentround = true
        end

        if autofarmcoins and not waitingfornextround then
            refreshcoins()
            setnoclip(true)

            setstatus("collecting coins", Color3.fromRGB(100, 220, 120))
        end
    end)
end

