-- ======================== UTILS & COLOR PARSER ========================
local function getCharacter()
    return localplayer.Character
end

local function getHRP()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getItemPosition(item)
    if item:IsA("BasePart") then
        return item.Position
    elseif item:IsA("Model") then
        local success, pivot = pcall(function() return item:GetPivot() end)
        return success and pivot.Position or nil
    elseif item:IsA("Tool") then
        local handle = item:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            return handle.Position
        end
        local success, pivot = pcall(function() return item:GetPivot() end)
        return success and pivot.Position or nil
    end
    return nil
end

local function getItemColor(itemName)
    local name = string.lower(itemName)
    if string.find(name, "red") then return Color3.fromRGB(255, 50, 50)
    elseif string.find(name, "blue") then return Color3.fromRGB(50, 150, 255)
    elseif string.find(name, "green") then return Color3.fromRGB(50, 255, 50)
    elseif string.find(name, "yellow") then return Color3.fromRGB(255, 255, 50)
    elseif string.find(name, "orange") then return Color3.fromRGB(255, 140, 0)
    elseif string.find(name, "purple") then return Color3.fromRGB(180, 50, 255)
    elseif string.find(name, "pink") then return Color3.fromRGB(255, 105, 180)
    elseif string.find(name, "white") then return Color3.fromRGB(240, 240, 240)
    elseif string.find(name, "black") or string.find(name, "dark") then return Color3.fromRGB(80, 80, 80)
    elseif string.find(name, "gear") then return Color3.fromRGB(200, 170, 50) end
    return COLORS.DefaultItem
end

local function isPiggyItem(item)
    if not item.Parent then return false end
    if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("ModuleScript") or item:IsA("Camera") then
        return false
    end
    local pickupScript = item:FindFirstChild("ItemPickupScript")
    if not pickupScript then return false end
    if not item:FindFirstChildOfClass("ClickDetector") then return false end
    return true
end

local function hasKnife(target)
    if not target then return false end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("Tool") then
            local name = string.lower(desc.Name)
            if name:find("knife") or name:find("blade") or name:find("sword") or name:find("dagger") then
                return true
            end
        end
    end
    return false
end

local function isPiggy(target, plr)
    if not target then return false end
    if target:GetAttribute("IsPiggy") or target:GetAttribute("Piggy") or target:GetAttribute("Traitor") then
        return true
    end
    local flag = target:FindFirstChild("IsPiggy") or target:FindFirstChild("Piggy") or target:FindFirstChild("Traitor")
    if flag and flag:IsA("BoolValue") and flag.Value then
        return true
    end
    if plr and plr.Team then
        local teamName = string.lower(plr.Team.Name)
        if string.find(teamName, "piggy") or string.find(teamName, "traitor") or string.find(teamName, "infected") then
            return true
        end
    end
    local name = string.lower(target.Name)
    if string.find(name, "piggy") or string.find(name, "bot") or string.find(name, "infected") or string.find(name, "traitor") then
        return true
    end
    if target.Parent then
        local pName = string.lower(target.Parent.Name)
        if pName == "piggies" or pName == "infected" or pName == "traitor" then
            return true
        end
    end
    return false
end

local function isLocalPlayerPiggy()
    local char = getCharacter()
    if char and isPiggy(char, localplayer) then
        return true
    end
    if localplayer.Team then
        local tName = string.lower(localplayer.Team.Name)
        if string.find(tName, "piggy") or string.find(tName, "traitor") or string.find(tName, "infected") then
            return true
        end
    end
    return false
end

