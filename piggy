-- ======================== DYNAMIC SIZING ========================
local function updateGuiSizeAndWidth()
    local maxTextWidth = 0
    for _, label in pairs(itemDistanceLabels) do
        if label and label.Parent then maxTextWidth = math.max(maxTextWidth, 120) end
    end
    for _, label in pairs(entityDistanceLabels) do
        if label and label.Parent then maxTextWidth = math.max(maxTextWidth, 120) end
    end

    local calculatedWidth = math.max(MIN_WIDTH, maxTextWidth + 85 + 30)
    
    local contentH = 30
    if piggyContainer.Visible then
        contentH += piggyHeader.AbsoluteSize.Y + piggyListLayout.AbsoluteContentSize.Y + 4
    end
    if traitorContainer.Visible then
        contentH += traitorHeader.AbsoluteSize.Y + traitorListLayout.AbsoluteContentSize.Y + 4
    end
    if playersContainer.Visible then
        contentH += playersHeader.AbsoluteSize.Y + playersListLayout.AbsoluteContentSize.Y + 4
    end
    if itemContainer.Visible then
        contentH += itemsHeader.AbsoluteSize.Y + itemListLayout.AbsoluteContentSize.Y + 4
    end

    local totalHeight = BASE_HEIGHT + contentH

    if calculatedWidth == lastGuiWidth and totalHeight == lastGuiHeight then return end
    lastGuiWidth = calculatedWidth
    lastGuiHeight = totalHeight

    if resizeTween then resizeTween:Cancel() end
    resizeTween = tweenservice:Create(mainframe, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(calculatedWidth, totalHeight)
    })
    resizeTween:Play()
end

