local function removeItem(item)
    if highlights[item] then pcall(function() highlights[item]:Destroy() end); highlights[item] = nil end
    if itemEntries[item] then pcall(function() itemEntries[item]:Destroy() end); itemEntries[item] = nil end
    itemDistanceLabels[item] = nil
    if itemConnections[item] then
        for _, conn in ipairs(itemConnections[item]) do conn:Disconnect() end
        itemConnections[item] = nil
    end
    itemContainer.Visible = (next(itemEntries) ~= nil)
    itemsHeader.Visible = itemContainer.Visible
    updateGuiSizeAndWidth()
end

