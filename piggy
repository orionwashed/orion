-- ======================== INTELLIGENT REFRESH LOOP ========================
local function refreshEntitiesAndDistances()
    if not scriptrunning then return end

    local hrp = getHRP()
    local myPos = hrp and hrp.Position or Vector3.zero
    local localIsPiggy = isLocalPlayerPiggy()

    local foundPiggies = {}
    local foundTraitors = {}
    local foundPlayers = {}

    -- Check Players
    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= localplayer and plr.Character then
            local char = plr.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                if hasKnife(char) then
                    foundTraitors[char] = {name = plr.Name, player = plr}
                elseif not localIsPiggy and isPiggy(char, plr) then
                    foundPiggies[char] = {name = plr.Name, player = plr}
                else
                    foundPlayers[char] = {name = plr.Name, player = plr}
                end
            end
        end
    end

    -- Check Workspace Piggy Bots / NPCs
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
            local hum = desc:FindFirstChildOfClass("Humanoid")
            local root = desc:FindFirstChild("HumanoidRootPart")
            if not players:GetPlayerFromCharacter(desc) and root and hum and hum.Health > 0 then
                if isPiggy(desc, nil) or hasKnife(desc) then
                    local currentPos = root.Position
                    if not botPositions[desc] then
                        botPositions[desc] = {pos = currentPos, moved = false}
                    else
                        if (currentPos - botPositions[desc].pos).Magnitude > 2 then
                            botPositions[desc].moved = true
                        end
                    end

                    if botPositions[desc].moved then
                        foundPiggies[desc] = {name = "bot", player = nil}
                    end
                end
            end
        end
    end

    for target, _ in pairs(entityEntries) do
        local hum = target:FindFirstChildOfClass("Humanoid")
        if not foundPiggies[target] and not foundTraitors[target] and not foundPlayers[target] or (hum and hum.Health <= 0) then
            removeEntity(target)
        end
    end

    for char, data in pairs(foundPiggies) do
        if not entityEntries[char] then
            addEntity(char, data.name, COLORS.Piggy, piggyContainer, data.player)
        else
            if highlights[char] and highlights[char].FillColor ~= COLORS.Piggy then
                highlights[char].FillColor = COLORS.Piggy
                highlights[char].OutlineColor = getOutlineColor(COLORS.Piggy)
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and entityDistanceLabels[char] then
            local dist = math.floor((root.Position - myPos).Magnitude)
            entityDistanceLabels[char].Text = dist .. " studs"
        end
    end

    for char, data in pairs(foundTraitors) do
        if not entityEntries[char] then
            addEntity(char, data.name, COLORS.Traitor, traitorContainer, data.player)
        else
            if highlights[char] and highlights[char].FillColor ~= COLORS.Traitor then
                highlights[char].FillColor = COLORS.Traitor
                highlights[char].OutlineColor = getOutlineColor(COLORS.Traitor)
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and entityDistanceLabels[char] then
            local dist = math.floor((root.Position - myPos).Magnitude)
            entityDistanceLabels[char].Text = dist .. " studs"
        end
    end

    for char, data in pairs(foundPlayers) do
        if not entityEntries[char] then
            addEntity(char, data.name, COLORS.Player, playersContainer, data.player)
        else
            if highlights[char] and highlights[char].FillColor ~= COLORS.Player then
                highlights[char].FillColor = COLORS.Player
                highlights[char].OutlineColor = getOutlineColor(COLORS.Player)
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and entityDistanceLabels[char] then
            local dist = math.floor((root.Position - myPos).Magnitude)
            entityDistanceLabels[char].Text = dist .. " studs"
        end
    end

    for item, label in pairs(itemDistanceLabels) do
        if item.Parent then
            local pos = getItemPosition(item)
            if pos then
                local dist = math.floor((pos - myPos).Magnitude)
                label.Text = dist .. " studs"
            end
        end
    end

    if fullbrightEnabled then
        lighting.Brightness = 2
        lighting.ClockTime = 14
        lighting.FogEnd = 100000
        lighting.GlobalShadows = false
        lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end

    if noclipEnabled and localplayer.Character then
        local myChar = localplayer.Character
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                originalCollision[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end
end

task.spawn(function()
    while scriptrunning do
        task.wait(0.25)
        refreshEntitiesAndDistances()
    end
end)

-- ======================== CTRL + CLICK TP ========================
local function teleportTo(position)
	local character = getCharacter()
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	character:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
end

addConnection(mouse.Button1Down:Connect(function()
    if not ctrlTpEnabled then return end
	if inputservice:IsKeyDown(Enum.KeyCode.LeftControl)
		or inputservice:IsKeyDown(Enum.KeyCode.RightControl) then

		if mouse.Hit then
			teleportTo(mouse.Hit.Position)
		end
	end
end))

-- ======================== FULL ABORT CLEANUP ========================
local function abortScript()
    if not scriptrunning then return end
    scriptrunning = false

    if noclipEnabled then
        for part, original in pairs(originalCollision) do
            if part and part.Parent then part.CanCollide = original end
        end
    end

    if fullbrightEnabled then
        lighting.Brightness = originalLighting.Brightness
        lighting.ClockTime = originalLighting.ClockTime
        lighting.FogEnd = originalLighting.FogEnd
        lighting.GlobalShadows = originalLighting.GlobalShadows
        lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    end

    for _, conn in ipairs(globalConns) do pcall(function() conn:Disconnect() end) end
    for _, hl in pairs(highlights) do pcall(function() hl:Destroy() end) end

    table.clear(highlights)
    table.clear(itemEntries)
    table.clear(itemDistanceLabels)
    table.clear(itemConnections)
    table.clear(entityEntries)
    table.clear(entityDistanceLabels)
    table.clear(entityConnections)
    table.clear(entityViewports)
    table.clear(botPositions)
    table.clear(globalConns)
    table.clear(originalCollision)

    pcall(function() screengui:Destroy() end)
end

