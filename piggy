-- ======================== ENTITY BUILDERS ========================
local function removeEntity(target)
    if highlights[target] then pcall(function() highlights[target]:Destroy() end); highlights[target] = nil end
    if entityEntries[target] then pcall(function() entityEntries[target]:Destroy() end); entityEntries[target] = nil end
    entityDistanceLabels[target] = nil
    if entityViewports[target] then pcall(function() entityViewports[target]:Destroy() end); entityViewports[target] = nil end
    botPositions[target] = nil
    if entityConnections[target] then
        for _, conn in ipairs(entityConnections[target]) do conn:Disconnect() end
        entityConnections[target] = nil
    end

    piggyContainer.Visible = false
    piggyHeader.Visible = false
    for model, container in pairs(entityEntries) do
        if container.Parent == piggyContainer then piggyContainer.Visible = true; piggyHeader.Visible = true end
    end

    traitorContainer.Visible = false
    traitorHeader.Visible = false
    for model, container in pairs(entityEntries) do
        if container.Parent == traitorContainer then traitorContainer.Visible = true; traitorHeader.Visible = true end
    end

    playersContainer.Visible = false
    playersHeader.Visible = false
    for model, container in pairs(entityEntries) do
        if container.Parent == playersContainer then playersContainer.Visible = true; playersHeader.Visible = true end
    end

    updateGuiSizeAndWidth()
end

