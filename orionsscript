local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer

local chams = {}
local itemChams = {}
local playerEvents = {}
local connections = {}
local updatePending = {}

local isRunning = true
local isEnabled = true
local fullbrightEnabled = false
local zoomEnabled = false

-- Save original camera and lighting settings
local originalMaxZoom = LocalPlayer.CameraMaxZoomDistance

local originalSettings = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient
}

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
local originalDensity = atmosphere and atmosphere.Density or nil

-- Random name helper
local function getRandomName()
    local names = {"Part", "Folder", "Model", "Attachment", "Configuration"}
    return names[math.random(1, #names)]
end

-- Highlight colors
local COLORS = {
    Gun = Color3.fromRGB(0, 150, 255),        -- Blue (Sheriff)
    Knife = Color3.fromRGB(255, 60, 60),      -- Red (Murderer)
    Default = Color3.fromRGB(0, 255, 0),     -- Green (Innocent)
    HighHealth = Color3.fromRGB(255, 0, 0),   -- Red (>500 HP)
    DroppedGun = Color3.fromRGB(255, 215, 0)  -- Yellow (Dropped Gun)
}

local function darken(c)
    return Color3.new(c.R * 0.6, c.G * 0.6, c.B * 0.6)
end

-- Check character or backpack for tools
local function scanContainer(container)
    if not container then return nil end
    for _, tool in ipairs(container:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("gun") or name:find("pistol") then
                return COLORS.Gun
            elseif name:find("knife") then
                return COLORS.Knife
            end
        end
    end
    return nil
end

-- Determine player highlight color
local function getChamColor(plr)
    local char = plr.Character
    if not char then return COLORS.Default end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 500 then
        return COLORS.HighHealth
    end

    return scanContainer(char) 
        or scanContainer(plr:FindFirstChildOfClass("Backpack")) 
        or COLORS.Default
end

-- Smoothly queue updates
local function queuePlayerUpdate(plr)
    if updatePending[plr] or not isRunning then return end
    updatePending[plr] = true

    task.defer(function()
        updatePending[plr] = nil
        if not isRunning then return end

        local highlight = chams[plr]
        if highlight and highlight.Parent then
            local newColor = getChamColor(plr)
            if highlight.FillColor ~= newColor then
                highlight.FillColor = newColor
                highlight.OutlineColor = darken(newColor)
            end
        end
    end)
end

-- Clear old player event connections
local function clearPlayerEvents(plr)
    if playerEvents[plr] then
        for _, conn in ipairs(playerEvents[plr]) do
            conn:Disconnect()
        end
        playerEvents[plr] = nil
    end
end

-- Create highlight for a player
local function createChams(plr)
    if not isRunning or plr == LocalPlayer then return end

    local char = plr.Character
    if not char then return end

    local highlight = chams[plr]
    if not highlight or not highlight.Parent then
        highlight = Instance.new("Highlight")
        highlight.Name = getRandomName()
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0
        highlight.Enabled = isEnabled
        chams[plr] = highlight
    end

    highlight.Adornee = char
    highlight.Parent = char

    clearPlayerEvents(plr)
    playerEvents[plr] = {}

    local function attachContainerListeners(container)
        if not container then return end
        
        local added = container.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then queuePlayerUpdate(plr) end
        end)
        local removed = container.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then queuePlayerUpdate(plr) end
        end)

        table.insert(playerEvents[plr], added)
        table.insert(playerEvents[plr], removed)
    end

    attachContainerListeners(char)
    
    local backpack = plr:FindFirstChildOfClass("Backpack")
    if backpack then attachContainerListeners(backpack) end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local hpConn = humanoid.HealthChanged:Connect(function()
            queuePlayerUpdate(plr)
        end)
        table.insert(playerEvents[plr], hpConn)
    end

    queuePlayerUpdate(plr)
end

-- Remove player highlight
local function removeChams(plr)
    clearPlayerEvents(plr)
    updatePending[plr] = nil
    local h = chams[plr]
    if h then
        h:Destroy()
        chams[plr] = nil
    end
end

-- Check and highlight dropped guns
local function checkGunDrop(obj)
    if not isRunning or itemChams[obj] then return end

    local name = obj.Name:lower()
    if name == "gundrop" or name == "gun" then
        local highlight = Instance.new("Highlight")
        highlight.Name = getRandomName()
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = COLORS.DroppedGun
        highlight.OutlineColor = darken(COLORS.DroppedGun)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = isEnabled
        highlight.Adornee = obj
        highlight.Parent = obj

        itemChams[obj] = highlight

        local conn
        conn = obj.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if itemChams[obj] then
                    itemChams[obj]:Destroy()
                    itemChams[obj] = nil
                end
                if conn then conn:Disconnect() end
            end
        end)
    end
end

-- Toggle player & item highlights
local function toggleChams()
    isEnabled = not isEnabled
    for _, highlight in pairs(chams) do
        if highlight then highlight.Enabled = isEnabled end
    end
    for _, highlight in pairs(itemChams) do
        if highlight then highlight.Enabled = isEnabled end
    end
end

-- Toggle Fullbright and No-Fog
local function toggleFullbright()
    fullbrightEnabled = not fullbrightEnabled

    if fullbrightEnabled then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)

        if atmosphere then
            atmosphere.Density = 0
        end
    else
        Lighting.Brightness = originalSettings.Brightness
        Lighting.ClockTime = originalSettings.ClockTime
        Lighting.FogEnd = originalSettings.FogEnd
        Lighting.GlobalShadows = originalSettings.GlobalShadows
        Lighting.Ambient = originalSettings.Ambient
        Lighting.OutdoorAmbient = originalSettings.OutdoorAmbient

        if atmosphere and originalDensity then
            atmosphere.Density = originalDensity
        end
    end
end

-- Toggle Camera Zoom Distance (+50)
local function toggleZoom()
    zoomEnabled = not zoomEnabled

    if zoomEnabled then
        LocalPlayer.CameraMaxZoomDistance = originalMaxZoom + 50
    else
        LocalPlayer.CameraMaxZoomDistance = originalMaxZoom
    end
end

-- Full script shutdown and cleanup
local function destroyEverything()
    isRunning = false

    -- Restore camera zoom
    LocalPlayer.CameraMaxZoomDistance = originalMaxZoom

    -- Restore lighting if fullbright was active
    if fullbrightEnabled then
        toggleFullbright()
    end

    -- Disconnect general connections
    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    table.clear(connections)

    -- Clear player connections
    for plr in pairs(playerEvents) do clearPlayerEvents(plr) end

    -- Destroy highlights
    for plr, highlight in pairs(chams) do
        if highlight then highlight:Destroy() end
    end
    table.clear(chams)

    for obj, highlight in pairs(itemChams) do
        if highlight then highlight:Destroy() end
    end
    table.clear(itemChams)
    table.clear(updatePending)
end

-- Setup player event tracking
local function setupPlayer(plr)
    if plr == LocalPlayer then return end

    local charAdded = plr.CharacterAdded:Connect(function()
        task.wait(0.1)
        createChams(plr)
    end)

    local charRemoving = plr.CharacterRemoving:Connect(function()
        removeChams(plr)
    end)

    table.insert(connections, charAdded)
    table.insert(connections, charRemoving)

    if plr.Character then createChams(plr) end
end

-- Initialize for current and new players
for _, plr in ipairs(Players:GetPlayers()) do setupPlayer(plr) end
table.insert(connections, Players.PlayerAdded:Connect(setupPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(removeChams))

-- Watch Workspace for dropped guns
local addedConn = Workspace.ChildAdded:Connect(function(child)
    checkGunDrop(child)
    if child:IsA("Folder") or child:IsA("Model") then
        for _, descendant in ipairs(child:GetChildren()) do
            checkGunDrop(descendant)
        end
    end
end)
table.insert(connections, addedConn)

for _, child in ipairs(Workspace:GetChildren()) do checkGunDrop(child) end

-- Key controls listener
local keyConnection
keyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.K then
        keyConnection:Disconnect()
        destroyEverything()
    elseif input.KeyCode == Enum.KeyCode.L then
        toggleChams()
    elseif input.KeyCode == Enum.KeyCode.P then
        toggleFullbright()
    elseif input.KeyCode == Enum.KeyCode.O then
        toggleZoom()
    end
end)
table.insert(connections, keyConnection)
